---
import LeistungPage from '../../components/pages/LeistungPage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('leistungen', ({ data }) => data.lang === 'de' && data.category === 'erkrankungen');
  return items.map((item) => ({ params: { slug: item.id.split('/').pop() } }));
}

const { slug } = Astro.params;
---
<LeistungPage lang="de" category="erkrankungen" slug={slug} />
