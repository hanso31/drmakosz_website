---
import NewsPage from '../../components/pages/NewsPage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => data.lang === 'de' && data.published);
  return posts.map((post) => ({ params: { slug: post.id.split('/').pop() } }));
}

const { slug } = Astro.params;
---
<NewsPage lang="de" slug={slug} />
