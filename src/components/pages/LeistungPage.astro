---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  category: 'erkrankungen' | 'schoenheit';
  slug?: string;
}

const { lang, category, slug } = Astro.props;
const t = useTranslations(lang);
const slugOf = (id: string) => id.split('/').pop();

let detail = null;
let DetailContent = null;
if (slug) {
  const list = await getCollection('leistungen', ({ id, data }) => data.lang === lang && slugOf(id) === slug);
  detail = list[0] ?? null;
  if (detail) {
    const rendered = await render(detail);
    DetailContent = rendered.Content;
  }
}

const items = (await getCollection('leistungen', ({ data }) => data.lang === lang && data.category === category))
  .sort((a, b) => a.data.order - b.data.order);

const overview = await getEntry('pages', `${lang}/${category}`);
const OverviewContent = overview ? (await render(overview)).Content : null;
const overviewTitle = overview?.data.title ?? t(`category.${category}`);
---
<Base
  title={detail ? detail.data.title : overviewTitle}
  description={detail ? detail.data.description : (overview?.data.description ?? overviewTitle)}
  image={detail?.data.heroImage}
>
  {detail ? (
    <>
      <div class="quadrants">
        <div class="quadrant quadrant--text quadrant--beige">
          <p class="quadrant__eyebrow">{t(`category.${category}`)}</p>
          <h1>{detail.data.title}</h1>
          <p class="quadrant__lead">{detail.data.description}</p>
        </div>
        {detail.data.heroImage && (
          <div class="quadrant quadrant--media">
            <img src={detail.data.heroImage} alt={detail.data.heroAlt ?? ''} width="1200" height="446" fetchpriority="high" />
          </div>
        )}
      </div>
      <div class="quadrants quadrants--content">
        <nav class="quadrant quadrant--text quadrant--hell quadrant--nav" aria-label={t(`category.${category}`)}>
          <p class="quadrant__eyebrow">{t(`category.${category}`)}</p>
          <ul class="subnav">
            {items.map((l) => (
              <li>
                {slugOf(l.id) === slug
                  ? <span aria-current="page">{l.data.title}</span>
                  : <a href={localePath(lang, `/${category}/${slugOf(l.id)}/`)}>{l.data.title}</a>}
              </li>
            ))}
          </ul>
        </nav>
        <div class="quadrant quadrant--text quadrant--weiss prose">
          {DetailContent && <DetailContent />}
        </div>
      </div>
    </>
  ) : (
    <>
      <div class="quadrants">
        <div class="quadrant quadrant--text quadrant--beige">
          <h1>{overviewTitle}</h1>
          {overview?.data.description && <p class="quadrant__lead">{overview.data.description}</p>}
        </div>
        {overview?.data.heroImage && (
          <div class="quadrant quadrant--media">
            <img src={overview.data.heroImage} alt={overview.data.heroAlt ?? ''} width="1200" height="446" fetchpriority="high" />
          </div>
        )}
      </div>
      <div class="container section">
        {OverviewContent && (
          <div class="prose" style="margin-bottom: 2.5rem;">
            <OverviewContent />
          </div>
        )}
        <div class="card-grid">
          {items.map((l) => (
            <a class="card" href={localePath(lang, `/${category}/${slugOf(l.id)}/`)}>
              {l.data.heroImage && <img src={l.data.heroImage} alt={l.data.heroAlt ?? ''} loading="lazy" width="1200" height="446" />}
              <div class="card__body">
                <h3 class="card__title">{l.data.title}</h3>
                <p class="card__text">{l.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </>
  )}
</Base>

<style>
  .quadrants--content .quadrant { min-height: 0; }
  .quadrant--nav { justify-content: flex-start; }
  .subnav { list-style: none; margin: 0; padding: 0; }
  .subnav li { border-bottom: 1px solid var(--color-border); }
  .subnav li:last-child { border-bottom: none; }
  .subnav a, .subnav span {
    display: block;
    padding: 0.6rem 0;
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 500;
  }
  .subnav a:hover { color: var(--color-blau-dunkel); padding-left: 0.35rem; transition: padding 0.15s ease; }
  .subnav span { color: var(--color-blau-dunkel); font-weight: 700; }
  .subnav span::before { content: '→ '; }
</style>
