---
import Base from '../../layouts/Base.astro';
import ContactForm from '../ContactForm.astro';
import { getEntry, render } from 'astro:content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const page = await getEntry('pages', `${lang}/kontakt`);
if (!page) throw new Error(`Kontakt-Seite fehlt für Sprache ${lang}`);
const settings = await getEntry('settings', lang);
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <div class="quadrants">
    <div class="quadrant quadrant--text quadrant--beige">
      <h1>{page.data.title}</h1>
      {settings && (
        <address class="contact-address">
          <strong>{settings.data.doctorName}</strong><br />
          {settings.data.specialty}<br />
          {settings.data.street}<br />
          {settings.data.zipCity}
        </address>
      )}
      {settings && (
        <p class="contact-links">
          <a href={`tel:${settings.data.phone.replace(/\s/g, '')}`}>{settings.data.phone}</a><br />
          <a href={`tel:${settings.data.phoneMobile.replace(/\s/g, '')}`}>{settings.data.phoneMobile}</a><br />
          <a href={`mailto:${settings.data.email}`}>{settings.data.email}</a>
        </p>
      )}
    </div>
    {page.data.heroImage && (
      <div class="quadrant quadrant--media">
        <img src={page.data.heroImage} alt={page.data.heroAlt ?? ''} width="1200" height="800" fetchpriority="high" />
      </div>
    )}
    <div class="quadrant quadrant--text quadrant--hell">
      <h2>{t('contact.directions.title')}</h2>
      <div class="prose">
        <Content />
      </div>
    </div>
    <div class="quadrant quadrant--text quadrant--weiss">
      <ContactForm lang={lang} />
    </div>
  </div>
</Base>

<style>
  .contact-address {
    font-style: normal;
    font-size: 1.08rem;
    line-height: 1.8;
    margin: 0 0 1rem;
  }
  .contact-links { font-size: 1.08rem; line-height: 1.9; margin: 0; }
  .quadrant .form h2 { margin-top: 0; }
  .quadrant .form { max-width: none; }
</style>
