---
import { useTranslations, type Lang } from '../i18n/utils';

interface Slide {
  image: string;
  alt: string;
}

interface Props {
  slides: Slide[];
  label: string;
  lang: Lang;
}

const { slides, label, lang } = Astro.props;
const t = useTranslations(lang);
const id = `carousel-${Math.random().toString(36).slice(2, 8)}`;
---
{slides.length > 0 && (
  <div class="carousel" id={id} role="group" aria-roledescription="carousel" aria-label={label}>
    <div class="carousel__track" tabindex="0" aria-label={label}>
      {slides.map((s, i) => (
        <div class="carousel__slide" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`}>
          <img src={s.image} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} width="1920" height="1254" />
        </div>
      ))}
    </div>
    {slides.length > 1 && (
      <>
        <button class="carousel__btn carousel__btn--prev" aria-label={t('carousel.prev')} data-dir="-1">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="carousel__btn carousel__btn--next" aria-label={t('carousel.next')} data-dir="1">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="carousel__dots" aria-hidden="true">
          {slides.map((_, i) => <span class="carousel__dot" data-dot={i} />)}
        </div>
      </>
    )}
  </div>
)}

<script>
  document.querySelectorAll('.carousel').forEach((carousel) => {
    if (carousel.hasAttribute('data-init')) return;
    carousel.setAttribute('data-init', '');
    const track = carousel.querySelector('.carousel__track');
    const dots = carousel.querySelectorAll('.carousel__dot');
    if (!track) return;
    const update = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, j) => d.classList.toggle('is-active', j === i));
    };
    carousel.querySelectorAll('.carousel__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir')) || 1;
        track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
