---
import '@fontsource/quicksand/300.css';
import '@fontsource/quicksand/400.css';
import '@fontsource/quicksand/500.css';
import '@fontsource/quicksand/700.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, localePath, stripLangFromPath, languages, type Lang } from '../i18n/utils';
import { getEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const settings = await getEntry('settings', lang);

const canonicalPath = stripLangFromPath(Astro.url.pathname);
const canonicalUrl = new URL(localePath(lang, canonicalPath), Astro.site);
const ogImage = image ? new URL(image, Astro.site) : new URL('/images/startseite-hero.webp', Astro.site);

const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(localePath(l, canonicalPath), Astro.site).href,
}));

const jsonLd = settings && {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: settings.data.practiceName,
  medicalSpecialty: 'Dermatology',
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.data.street,
    addressLocality: 'Basel',
    postalCode: '4051',
    addressCountry: 'CH',
  },
  telephone: settings.data.phone,
  email: settings.data.email,
  url: Astro.site?.href,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(canonicalPath, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : lang === 'fr' ? 'fr_CH' : 'en_GB'} />
    <meta name="theme-color" content="#736357" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} settings={settings} />
  </body>
</html>
